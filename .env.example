QWEN_BASE_URL=http://127.0.0.1:11434
QWEN_MODEL=qwen2.5vl:7b
VISION_BASE_URL=http://127.0.0.1:8788

# Optional cloud fallback. Leave empty to keep every request on this machine.
# When set, the Gemini provider can be selected in Settings; sources are then
# uploaded to Google instead of staying local.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_ESCALATION_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
GEMINI_REQUEST_TIMEOUT_MS=60000

# Optional provider-diverse fallback. In Automatic mode the source is sent here
# only after Gemini is unavailable. The Settings test control can also select
# this model directly. Keep provider rerouting disabled in the API route so an
# archive image reaches only the provider named by the selected model.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.6-luna
# Additional comma-separated models may be exposed in the temporary selector.
OPENROUTER_MODELS=
OPENROUTER_MAX_OUTPUT_TOKENS=8000

# Who performs the second, independent reading of each register cell.
# "local" (default) uses SESHAT_REVIEW_MODEL on this machine: no quota, no cost,
# and a different architecture from the first reader, which is a stronger
# independence check than a second model from the same cloud family.
# "gemini" uses GEMINI_ESCALATION_MODEL instead and needs PAID quota — the free
# tier allows 20 requests per day per model and one page spends more than that.
SESHAT_REVIEW_PROVIDER=local
SESHAT_REVIEW_MODEL=qwen2.5vl:7b

# Hybrid default: use one stronger cloud verification request for the short
# material column, where the local 7B reviewer is least reliable. Set to local
# to disable that request.
SESHAT_MATERIAL_REVIEW_PROVIDER=gemini
