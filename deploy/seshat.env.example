# Copy to /etc/seshat/seshat.env, set mode 0600, and edit on the VM.
# Never commit or paste real keys into chat.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_ESCALATION_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
GEMINI_REQUEST_TIMEOUT_MS=60000
GEMINI_SOURCE_CONCURRENCY=3

# Optional fallback.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.6-luna
OPENROUTER_MAX_OUTPUT_TOKENS=8000
